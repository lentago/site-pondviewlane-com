---
/**
 * AskDock — floating site-wide entry to the Ask chat, mounted by the Footer
 * override on every page that doesn't already render an inline AskWidget
 * (the homepage hero and /ask do; the widget's element ids must stay unique
 * per page). The widget inside shares the sessionStorage transcript, so a
 * conversation started anywhere keeps going here — and the panel's open
 * state also persists across pages in the tab, so an open chat stays open
 * while the visitor reads.
 */
import AskWidget from './AskWidget.astro';
---

<div class="ask-float not-content">
  <div class="ask-float-panel" id="ask-float-panel" role="dialog" aria-label="Ask about the HOA" hidden>
    <div class="ask-float-head">
      <strong>Ask about the HOA</strong>
      <a class="ask-float-full" href="/ask/" title="Continue on the full Ask page" aria-label="Continue on the full Ask page">⤢</a>
      <button type="button" class="ask-float-close" id="ask-float-close" aria-label="Close the chat panel">×</button>
    </div>
    <AskWidget variant="dock" />
  </div>
  <button type="button" class="ask-float-btn" id="ask-float-btn" aria-expanded="false" aria-controls="ask-float-panel" title="Ask about the HOA">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
    </svg>
    <span class="sr-only">Ask about the HOA</span>
  </button>
</div>

<script is:inline>
  (() => {
    const btn = document.getElementById('ask-float-btn');
    const panel = document.getElementById('ask-float-panel');
    const OPEN = 'pvl-ask-dock-open';
    function setOpen(open, focus) {
      panel.hidden = !open;
      btn.setAttribute('aria-expanded', String(open));
      try { sessionStorage.setItem(OPEN, open ? '1' : ''); } catch { /* fine */ }
      if (!open) return;
      const log = panel.querySelector('#ask-log');
      if (log) log.scrollTop = log.scrollHeight;
      if (focus) panel.querySelector('#ask-input')?.focus({ preventScroll: true });
    }
    btn.addEventListener('click', () => setOpen(panel.hidden, true));
    document.getElementById('ask-float-close').addEventListener('click', () => setOpen(false));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !panel.hidden) setOpen(false); });
    // Reopen if it was open on the previous page — but never steal focus on load.
    try { if (sessionStorage.getItem(OPEN) === '1') setOpen(true, false); } catch { /* stays closed */ }
  })();
</script>
