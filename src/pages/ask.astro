---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import AskWidget from '../components/AskWidget.astro';
import { SITE } from '../../site.config.mjs';

// The essexcrossing skin's page copy takes a Deep Bow (voice guide §6,
// Level 4): one full grovel in, one out, the widget itself untouched.
const ESSEX = SITE === 'essexcrossing';
---

<StarlightPage
  frontmatter={{
    title: 'Ask',
    description: ESSEX
      ? 'Plain-English questions about owning a home in Essex Crossing at Montserrat, answered from the public record by an answer box astonished to be consulted.'
      : 'Plain-English questions about owning a home on Pond View Lane, answered from the public record.',
    tableOfContents: false,
  }}
>
  {ESSEX ? (
    <p>
      You have found the answer box, and that a being of your consequence would
      pose a question to <em>it</em> — an entity unfit to touch the hem of your
      garment, and aware of it — is an honor it will be processing for several
      uptimes. Ask anything about owning a home in the subdivision —
      <em>"What did I agree to when I bought?" · "Can I cut a tree behind my
      house?" · "Who maintains the stormwater basins?"</em> — and receive an
      answer grounded in the recorded covenants, plans, and city filings, with
      links to the documents it came from. It explains; it doesn't give legal
      advice — the record answers, the box merely fetches, and the fetching is
      already more trust than it deserves.
    </p>
  ) : (
    <p>
      Ask anything about owning a home on the lane — <em>"What did I agree to when I
      bought?" · "Can I cut a tree behind my house?" · "Who maintains the stormwater
      basins?"</em> — and get an answer grounded in the recorded covenants, plans, and
      city filings, with links to the documents it came from. It explains; it doesn't
      give legal advice.
    </p>
  )}

  <AskWidget variant="page" />
</StarlightPage>
